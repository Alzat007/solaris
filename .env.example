# Client-visible, read-only ion token. Never use an account/admin token.
# Configure locally in .env.local; keep Selected assets and Allowed URLs restricted.
# No network provider is enabled until /?data=ion is opened manually (without qa=1).
VITE_CESIUM_ION_READ_TOKEN=
# Match these IDs to the two selected assets in your own ion account.
VITE_CESIUM_TERRAIN_ASSET_ID=1
VITE_CESIUM_IMAGERY_ASSET_ID=3830183
